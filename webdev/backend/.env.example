PORT=4001
NODE_ENV=development

# --- JWT (rotate for production) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# --- Admin credentials ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# --- PII encryption (Fernet) — REQUIRED in production ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=change_this_fernet_key

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
DATABASE_URL=postgresql://user:password@localhost:5432/bizzcheck
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bizzcheck
DB_USER=postgres
DB_PASSWORD=postgres

# --- Telegram bot bridge (used by the frontend to build deep-link URLs) ---
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME

# --- Pool de conexiuni (database/db.py) ---
# Gol / absent = defaulturile din cod (2 / 10). Plafonul real în producție e
# 4 workeri gunicorn x DB_POOL_MAX. Se citesc cu int() — nu lăsa valori goale.
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Rate limiting (server.py) ---
# Gol = memory:// (contor separat per proces gunicorn → plafon efectiv ~4x cel
# nominal). Pentru limite exacte: redis://redis:6379/0
RATELIMIT_STORAGE_URI=

# --- Rollout etapizat X-Bot-Secret pe /tg/contact, /tg/email, /tg/lead ---
# 0 = fail-open (comportamentul actual: apelantul fără header e acceptat)
# 1 = header obligatoriu, altfel 403. Treci pe 1 doar după ce backend + tgbot
#     rulează cu acelasi BOT_SHARED_SECRET nevid.
TG_REQUIRE_BOT_SECRET=0

# --- Identitatea din subsolul emailului (services/email_templates.py) ---
# ATENTIE: defaulturile din cod sunt inca moldovenesti (office@bizcheck.md,
# https://crowe-tm.md, @CROWE_TM). Lasa gol pana exista contactele UA — gol
# inseamna "se foloseste defaultul din cod", nu "camp gol in email".
EMAIL_REPLY_TO=
EMAIL_SITE_URL=
EMAIL_TELEGRAM_URL=
EMAIL_TELEGRAM_HANDLE=
# Gol -> <PUBLIC_BASE_URL>/confidentialitate (ruta legacy, 301 catre /uk/privacy).
# In Docker, docker-compose.yml pune direct <PUBLIC_BASE_URL>/uk/privacy.
EMAIL_PRIVACY_URL=
