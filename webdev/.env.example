# ─── BizCheck — Single Environment File ─────────────────────
# Copy this to .env and fill in your values before running docker compose up.
# All services (db, backend, frontend, tgbot) read from this single file.

# ── Database ──
# Aceste trei variabile aparțin SERVICIULUI `db`: devin POSTGRES_DB/USER/PASSWORD
# la initdb și `pg_isready -U $DB_USER` în healthcheck. DB_USER trebuie să rămână
# superuserul clusterului (`postgres`) — NU-l schimba în `bizcheck_app`.
# POSTGRES_USER/PASSWORD sunt citite de imagine DOAR pe un volum gol; pe un
# `pgdata` deja populat sunt ignorate, deci schimbarea lor mai târziu nu rotește
# nicio parolă — doar strică DSN-ul implicit al backendului.
DB_NAME=bizzcheck
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD

# OPȚIONAL. Lasă-l comentat pentru comportamentul normal: docker-compose.yml
# construiește singur DSN-ul din DB_USER/DB_PASSWORD/DB_NAME de mai sus, adică
# backendul se conectează ca SUPERUSER.
#
# Se decomentează într-un singur caz: după ce ai rulat procedura din
# backend/DATABASE_ROLE.md și ai creat rolul dedicat, non-superuser,
# `bizcheck_app`. Atunci linia de mai jos are prioritate față de valoarea
# calculată și devine singura credențială de DB din containerul backend
# (DB_PASSWORD nu mai ajunge la el deloc).
#
#   DATABASE_URL=postgresql://bizcheck_app:PAROLA_GENERATA@db:5432/bizzcheck
#
# ⚠ Parola NU are voie să conțină `$` (Compose l-ar interpreta ca variabilă și ar
#   trunchia parola în tăcere) și nici `@ : / #` (ar rupe parsarea URL-ului).
#   Generatorul din DATABASE_ROLE.md produce deja doar caractere alfanumerice.
# ⚠ Gol (`DATABASE_URL=`) înseamnă „nesetat": se revine la DSN-ul calculat.
#   Ăsta e și rollbackul — comentează linia și repornește backendul.
# Verifică după repornire cu:  ./scripts/check-db-role.sh
#DATABASE_URL=

# ── Backend ──
JWT_SECRET=CHANGE_THIS_STRONG_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_STRONG_REFRESH_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD
# Fernet key for PII encryption at rest. REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=CHANGE_THIS_FERNET_KEY
# Local: http://localhost:5173  |  Production: https://bizcheck.com.ua
CORS_ORIGIN=https://bizcheck.com.ua
NODE_ENV=production
# Anti Host-Header-Injection: doar aceste valori de Host sunt acceptate (restul → 400).
# Blochează scanarea directă pe IP. `backend` e numele intern al serviciului Docker pe
# care îl folosesc tgbot/groupbot (http://backend:4001), deci TREBUIE să rămână în listă.
# Lista goală = verificarea e dezactivată (util doar în dev).
ALLOWED_HOSTS=bizcheck.com.ua,www.bizcheck.com.ua,backend,localhost,127.0.0.1
# URL-ul public folosit pentru a construi linkul de descărcare a raportului în emailuri
# și în mesajele Telegram. Fără schemă corectă, linkurile din email pică.
PUBLIC_BASE_URL=https://bizcheck.com.ua

# ── Pool-ul de conexiuni la Postgres (backend/database/db.py) ──
# Lasă-le goale pentru defaulturile din cod (2 / 10) — docker-compose.yml le
# repetă ca `${DB_POOL_MAX:-10}`, deci gol = default, nu 0.
# CE SE STRICĂ dacă lipsesc: nimic — dar până acum nici nu AVEAU efect: nu erau
# pasate serviciului `backend`, deci le puteai scrie aici degeaba, iar
# ./scripts/check-db-role.sh calcula CONNECTION LIMIT pe o valoare pe care
# backendul n-o vedea. Acum valoarea de aici e cea reală.
# ⚠ Plafonul efectiv de conexiuni e 4 (workeri gunicorn) × DB_POOL_MAX = 40.
#   Dacă urci DB_POOL_MAX, rulează din nou:
#     ALTER ROLE bizcheck_app CONNECTION LIMIT <4 × DB_POOL_MAX + 10>;
#   altfel apare „too many connections for role" sub încărcare.
# ⚠ NU pune o valoare non-numerică: se citește cu int() → backendul cade la
#   import și intră în restart-loop.
DB_POOL_MIN=
DB_POOL_MAX=

# ── Contoarele de rate-limit (backend/server.py) ──
# GOL (implicit) = `memory://`: fiecare din cele 4 procese gunicorn ține contorul
# LUI, deci plafonul real e ~4× cel nominal (200/min per IP ≈ 800/min) și se
# resetează la orice redeploy. Ăsta e compromisul acceptat azi — mai ieftin decât
# un Redis, iar limita de login rămâne bounded prin regula suplimentară de 40/oră.
# CE SE STRICĂ dacă lipsește: nimic imediat; limitele rămân aproximative. Pentru
# limite EXACTE adaugă un serviciu `redis` în docker-compose.yml și pune aici:
#   RATELIMIT_STORAGE_URI=redis://redis:6379/0
RATELIMIT_STORAGE_URI=

# ── Rollout etapizat al lui X-Bot-Secret pe rutele /tg care scriu PII ──
# Acoperă /tg/contact, /tg/email și /tg/lead (backend/routes/telegram.py) —
# endpointurile prin care intră nume, email și telefon de la client.
#   0 (implicit) = comportamentul actual: un apelant care NU trimite deloc
#                  headerul X-Bot-Secret e ACCEPTAT, cu un warning în log
#                  (fail-open). Un token de deep-link scurs e atunci suficient
#                  ca un terț să scrie date personale pe o submisie.
#   1            = headerul devine OBLIGATORIU; fără el → 403. Un header prezent
#                  dar greșit e respins cu 403 în ambele moduri.
# CE SE STRICĂ dacă lipsește: nimic vizibil — rutele rămân fail-open pentru
# totdeauna. (Până acum variabila nici nu era pasată în container, deci pe „1"
# nu se putea trece deloc.)
# CUM SE ACTIVEAZĂ, în ordinea asta:
#   1. BOT_SHARED_SECRET nevid, ACELAȘI pentru backend și tgbot (vezi mai jos);
#   2. redeploy ambele servicii;
#   3. abia apoi TG_REQUIRE_BOT_SECRET=1 + redeploy backend.
# Invers, botul primește 403 și livrarea rapoartelor se oprește.
TG_REQUIRE_BOT_SECRET=0

# ── Exporturi asincrone (ZIP-ul de PDF-uri din panoul de admin) ──
# Exportul de PDF-uri rulează ca job de fundal și se scrie pe DISC, nu în RAM.
# Dimensiuni măsurate pe corpusul real (~3,2 MB/PDF):
#   100 submisii → 323 MB | 250 → 807 MB | 500 → ~1,6 GB
# Directorul de pe GAZDĂ în care se montează spoolul. Implicit `./export_spool`,
# adică webdev/export_spool (e în .gitignore și în .dockerignore).
# Mută-l pe alt disc dacă partiția cu Docker e mică — de ex. /mnt/data/bizcheck_exports.
# ⚠ Calea TREBUIE să înceapă cu `./`, `/` sau `~`. Un nume simplu (`export_spool`)
#   e interpretat de Docker ca VOLUM NUMIT nedeclarat, iar `docker compose up` cade cu
#   „service 'backend' refers to undefined volume".
# Calea DIN container (/var/spool/bizcheck_exports) e fixată în docker-compose.yml
# și NU se configurează de aici; dacă o schimbi acolo, schimbă și ținta mountului.
EXPORT_SPOOL_HOST_DIR=./export_spool

# ⚠ NU EXISTĂ LIMITĂ DE SPAȚIU. Curățenia (sweep) e pur TEMPORALĂ: șterge după
# ce expiră TTL-urile de mai jos, nu când discul se apropie de plin. Coada e
# limitată la 16 joburi per proces gunicorn și un job activ per test (clickul
# dublu nu construiește două arhive), dar N teste diferite exportate în aceeași
# oră înseamnă N × 1,6 GB pe disc simultan.
# Verifică/curăță manual:  ./scripts/export-spool.sh        (raport)
#                          ./scripts/export-spool.sh --purge (șterge tot spoolul)
# Regulă de degetul mare: ține liber cel puțin 3 × dimensiunea celui mai mare export.

# Cât se păstrează o arhivă gata, dar NEDESCĂRCATĂ (secunde). 3600 = 1h.
# Lasă implicitul: adminul apasă „Export", pleacă la o ședință, se întoarce și
# arhiva mai e acolo. Scade-l (ex. 900) DOAR dacă discul e strâmt.
EXPORT_JOB_READY_TTL=3600
# Perioada de grație DUPĂ descărcare (secunde). 600 = 10 min — suficient ca un
# transfer de 1,6 GB întrerupt să fie reluat, destul de scurt cât să nu se adune
# gigabytes. Nu-l pune 0: o descărcare picată ar cere reconstruirea arhivei.
EXPORT_JOB_DOWNLOADED_TTL=600
# Cât se păstrează un job EȘUAT, ca adminul să mai apuce să citească motivul
# (secunde). 1800 = 30 min. Jobul eșuat nu ocupă spațiu — doar un state.json.
EXPORT_JOB_FAILED_TTL=1800
# Fără semn de viață atâta timp cât rulează → jobul e declarat mort (secunde).
# 900 = 15 min, cu mult peste cele ~32 s ale celui mai mare export măsurat;
# acoperă un worker ucis de OOM sau de redeploy fără să omoare un job lent-dar-viu.
EXPORT_JOB_STALE_AFTER=900

# ── Frontend ──
FRONTEND_PORT=5173

# ── Variabile de BUILD ale frontendului (nu de runtime!) ──
# Ajung la `npm run build` prin lanțul:
#   .env → docker-compose.yml (frontend.build.args) → ARG/ENV în Dockerfile.frontend
# Toate sunt OPȚIONALE: goale, buildul reușește și doar loghează un avertisment.
# ⚠ Se citesc la BUILD. O valoare schimbată aici are efect abia după un rebuild al
#   serviciului `frontend` (./deploy.sh îl rebuildează oricum).

# Sursa rutelor DINAMICE (teste + șabloane) pentru sitemap.xml și pentru HTML-ul
# pre-randat (frontend/scripts/generate-sitemap.mjs, generate-static-html.mjs).
# Gol → sitemapul conține doar rutele statice, iar crawlerele fără JS văd shellul
# generic pe /uk/test/<slug> și /uk/templates/<slug>. Buildul NU cade.
# FORMAT: origine + prefixul de API, fără slash final (scripturile cer /tests și
# /templates sub el).
# ⚠ URL-ul se rezolvă din REȚEAUA CONTAINERULUI DE BUILD, care NU e rețeaua compose:
#   `http://backend:4001/...` nu se rezolvă, iar `http://127.0.0.1:5173/...` ar fi
#   containerul de build însuși. Folosește URL-ul PUBLIC — buildul are internet
#   (rulează `npm ci`). Valoarea pentru producție:
SITEMAP_API_URL=https://bizcheck.com.ua/api_crowe_bizcheck
# La PRIMUL deploy site-ul încă nu răspunde pe acest URL: fetchul dă timeout, buildul
# reușește, iar sitemapul iese fără rutele dinamice. E normal — după ce ai introdus
# conținutul în panoul de admin, regenerează-l cu:  FRONTEND_NO_CACHE=1 ./deploy.sh

# Domeniul canonic scris în sitemap și în tagurile pre-randate. Gol → valoarea din
# frontend/scripts/lib/routing.mjs (https://bizcheck.com.ua). Se setează DOAR pentru
# build-uri de staging pe alt domeniu.
SITEMAP_BASE_URL=
# Originea API-ului compilată în bundle (src/config/api.ts). Gol → calea relativă
# /api_crowe_bizcheck, servită de același nginx — corect în producție. Nu o seta
# decât dacă API-ul ajunge pe alt origin (atunci actualizează și CSP-ul din nginx.conf).
VITE_API_URL=

# ── Telegram Bot (client-facing report bot) ──
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME
# Brand + adresa de suport interpolate în FIECARE mesaj al botului
# (webdev/tgbot/config.py → strings.py, ca {site} și {contact}).
# ⚠ Defaultul din cod pentru CONTACT_EMAIL e încă office@bizcheck.md, iar
#   variabila nu era pasată deloc serviciului `tgbot` → botul ucrainean dădea
#   clienților adresa moldovenească indiferent ce scria aici. Acum are efect.
# CE SE STRICĂ dacă lipsesc: nimic nu cade — botul răspunde în continuare, dar
#   trimite clientului adresa de contact a pieței greșite.
# Lasă-le goale până există adresa .ua confirmată (gol = defaultul din cod).
# NU pune un placeholder YOUR_… — botul l-ar trimite clientului ca atare.
SITE_NAME=
CONTACT_EMAIL=

# ── Team group bot (notifications + /excel + /pdf) ──
# A SECOND bot from BotFather, added as admin (with "Manage Topics") to your team
# group. The backend posts test-completed notifications into a per-test topic and
# the groupbot service serves /excel and /pdf. Leave SALES_BOT_TOKEN empty to disable.
SALES_BOT_TOKEN=YOUR_GROUP_BOT_TOKEN_FROM_BOTFATHER
# OPTIONAL group id (negative, e.g. -1001234567890). Normally you leave this EMPTY
# and run /register in the group instead — the owner-only command binds the group at
# runtime (stored in site_settings.sales_chat_id).
# When set, this WINS over whatever /register bound: it is the operator kill-switch
# that pins leads to a known-good group and cannot be overridden from Telegram. Use
# it to recover from a bad or hostile /register — then clear it to hand control back.
SALES_CHAT_ID=
# Topic (message_thread_id) to which ALL lead notifications are pinned.
# LEAVE EMPTY for the normal setup: an own topic is then created automatically for
# each test (cached in tests.tg_topic_id). Setting this takes priority and collapses
# every test into this single topic — only do that if you really want one topic.
# (If the group is not a forum, or the bot lacks "Manage Topics", it falls back to General.)
SALES_TOPIC_ID=
# Ritmul notificărilor de lead în grup (backend/services/sales_notify.py).
# Goale = defaulturile din cod: 3.0 secunde între mesaje (≈20 msg/min, limita
# Telegram pentru grupuri) și 4 reîncercări la 429.
# CE SE STRICĂ dacă lipsesc: nimic — dar până acum nici nu aveau efect, pentru
# că nu erau pasate serviciului `backend`. Scade spacing-ul doar dacă știi ce
# faci: sub ~3 s Telegram începe să returneze 429 pe grup.
SALES_SEND_SPACING_SEC=
SALES_MAX_SEND_RETRY=
# Shared secret between the backend and BOTH bot services (tgbot + groupbot).
# REQUIRED for /excel and /client to work (export endpoints are disabled without it).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SHARED_SECRET=
# Admin panel URL shown by /pdf (bulk PDFs are downloaded from the panel, not Telegram).
ADMIN_PANEL_URL=https://bizcheck.com.ua/admin_bizcheck_md_crowe/
# Background scheduler that sends due feedback questions (services/feedback.py).
# Defaults to "1" (on) when unset. Set to "0" to disable the loop entirely.
FEEDBACK_SCHEDULER=1

# ── Email delivery (Office 365 SMTP) ──
# 1. Go to https://mysignins.microsoft.com/security-info for the sending mailbox
# 2. Add sign-in method → "App password" → name it "bizcheck-smtp"
# 3. Copy the 16-char generated password here.
# If these are empty, the email feature is silently disabled (no crash).
# IMPORTANT: SMTP_USER is the From address — keep it on the SAME domain as the site
# (bizcheck.com.ua) so SPF/DKIM/DMARC and the Message-ID/link domain all align
# (anti-spam). O adresă de pe alt domeniu → emailurile ajung în spam.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# TODO: adresa reală de expediere de pe bizcheck.com.ua — cutia poștală pe acest
# domeniu nu există încă. Placeholderele de mai jos NU trebuie lăsate în producție.
SMTP_USER=office@example.ua
SMTP_PASSWORD=
SMTP_FROM_NAME=Crowe Turcan Mikhailenko
# TODO: adresa reală UA — aici ajung răspunsurile clienților la emailul de raport.
SMTP_REPLY_TO=office@example.ua
# Publicly reachable logo URL used inside the HTML email template.
EMAIL_LOGO_URL=https://bizcheck.com.ua/logo_email.png

# ── Identitatea din SUBSOLUL emailului (backend/services/email_templates.py) ──
# Astea NU sunt configurarea SMTP de mai sus: sunt textele și linkurile pe care
# le VEDE clientul în emailul de raport (adresa de răspuns afișată, site-ul
# firmei, canalul de Telegram, linkul de confidențialitate).
# ⚠ ATENȚIE: defaulturile din COD sunt încă MOLDOVENEȘTI —
#     EMAIL_REPLY_TO       → office@bizcheck.md
#     EMAIL_SITE_URL       → https://crowe-tm.md
#     EMAIL_TELEGRAM_URL   → https://t.me/CROWE_TM
#     EMAIL_TELEGRAM_HANDLE→ @CROWE_TM
#   Până acum nu erau pasate serviciului `backend` prin docker-compose.yml, deci
#   a le scrie aici era un NO-OP silențios și fiecare email pleca cu identitatea
#   .md. Acum valoarea de aici câștigă.
# CE SE STRICĂ dacă lipsesc: nu cade nimic — emailurile continuă să plece, dar
#   cu contactele moldovenești, adică cu identitatea greșită de piață.
# Lasă-le GOALE până există contactele UA confirmate: gol = se revine la
# defaultul din cod. NU pune aici placeholdere de tip YOUR_… — ar ajunge tale
# quale în emailul clientului.
# TODO(UA): completează-le în momentul în care există cutia poștală și canalul
#   de Telegram pe bizcheck.com.ua. Sunt doar variabile de mediu — fără redeploy
#   de cod, doar repornirea serviciului `backend`.
EMAIL_REPLY_TO=
EMAIL_SITE_URL=
EMAIL_TELEGRAM_URL=
EMAIL_TELEGRAM_HANDLE=
# Linkul „Politica de confidențialitate" din email. Gol → docker-compose.yml
# construiește ${PUBLIC_BASE_URL}/uk/privacy, adică ruta CANONICĂ de azi.
# (Defaultul din cod e vechea rută /confidentialitate, care mai există doar ca
# 301 în nginx.conf — funcționează, dar pe redirect.)
EMAIL_PRIVACY_URL=

# ── Masca de pre-lansare (Basic Auth + noindex) — NU se configurează de aici ──
# Cât timp site-ul nu e lansat, tot conținutul public stă în spatele unei cereri
# de user/parolă, iar răspunsurile poartă `X-Robots-Tag: noindex`.
#
# Nu există nicio variabilă în .env pentru asta, INTENȚIONAT: parola n-are ce
# căuta într-un fișier de configurare, iar comutatorul trebuie să se poată
# schimba fără redeploy. Ambele stau în `webdev/nginx-maintenance/`, bind mount
# în serviciul `frontend`, ținut în afara git-ului:
#
#     ./scripts/site-mask.sh adduser <nume>   # creează parola (o cere interactiv)
#     ./scripts/site-mask.sh on               # pornește masca (+ reload nginx)
#     ./scripts/site-mask.sh status
#     ./scripts/site-mask.sh off              # LANSARE: scoate parola ȘI noindex-ul
#
# `deploy.sh` detectează singur starea și își ajustează smoke-testul; te oprește
# dacă masca e oprită, dar `noindex` a rămas agățat. Detalii: documentation/
# runbook-lansare.md §2.5.
