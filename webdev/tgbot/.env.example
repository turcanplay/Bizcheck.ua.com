# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# Username of the bot (without @), used to build deep links
TELEGRAM_BOT_USERNAME=CROWE_BIZCHECK_bot

# Internal URL of the backend service (inside Docker network)
BACKEND_URL=http://backend:4001

# Shared secret for the bot-only backend endpoints. Sent as X-Bot-Secret on
# every /tg/* call. Must match BOT_SHARED_SECRET on the backend.
# Leave empty to run ungated (dev only).
BOT_SHARED_SECRET=

# Public brand name and support address used in every bot message.
# TODO: confirmă contactul pentru piața UA — adresa implicită de mai jos e
# cutia poștală reală și funcțională a firmei. Păstreaz-o până există o adresă
# ucraineană confirmată.
SITE_NAME=Bizcheck.com.ua
CONTACT_EMAIL=office@bizcheck.md
