# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# Username of the UA bot (without @). Must match the token's actual bot;
# startup verifies it before changing any profile setting.
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME

# Internal URL of the backend service (inside Docker network)
BACKEND_URL=http://backend:4001

# Shared secret for the bot-only backend endpoints. Sent as X-Bot-Secret on
# every /tg/* call. Must match BOT_SHARED_SECRET on the backend.
# Required: an empty value prevents the bot from starting.
BOT_SHARED_SECRET=

# Public copy/profile/logo are source-controlled only (bot_profile.py,
# strings.py, assets/profile.jpg). There are no environment branding overrides.
