# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# Username of the bot (without @), used to build deep links
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME

# Internal URL of the backend service (inside Docker network)
BACKEND_URL=http://backend:4001

# Shared secret for the bot-only backend endpoints. Sent as X-Bot-Secret on
# every /tg/* call. Must match BOT_SHARED_SECRET on the backend.
# Leave empty to run ungated (dev only).
BOT_SHARED_SECRET=

# Public brand name and support address used in every bot message
# (config.py → strings.py, interpolated as {site} / {contact}).
#
# ⚠ ÎN DOCKER fișierul ăsta nu se citește: containerul primește valorile din
#   webdev/.env prin blocul `environment:` al serviciului `tgbot` din
#   webdev/docker-compose.yml (niciun serviciu nu are `env_file:`). Setează-le
#   ACOLO. Fișierul de față e doar pentru rularea botului local, în afara
#   compose-ului.
#
# TODO: confirmă contactul pentru piața UA — adresa de mai jos e cutia poștală
# reală și funcțională a firmei, dar e MOLDOVENEASCĂ; e și defaultul rămas în
# tgbot/config.py. Înlocuiește-o imediat ce există o adresă .ua confirmată.
SITE_NAME=Bizcheck.com.ua
CONTACT_EMAIL=office@bizcheck.md
